# Copy to .env and fill in for your deployment

# Random long string - used to sign caregiver/patient JWTs
SECRET_KEY=change-this-to-a-long-random-string

# SQLite ships with the app by default; point this at Postgres/MySQL later if you outgrow it
DATABASE_URL=sqlite:///./medadhere.db

# Local storage paths (mount a persistent volume onto these in production)
STORAGE_DIR=./storage
VIDEO_DIR=./storage/videos
KNOWLEDGE_DIR=./storage/knowledge
VOICE_DIR=./storage/voice

# The already-deployed Ally Healthwise AI service
AI_API_BASE_URL=http://localhost:9000
AI_API_TIMEOUT_SECONDS=30
